<%- include("partials/header.ejs") %>
<!--BANNER AREA BEGINS-->
<div class="banner-container">
  <img src="/img/courses/courses-banner.png" alt="banner" loading="lazy" />
  <div class="overlay">
    <div class="banner-collection">
      <div id="decision-area">
        <h1>COURSES</h1>

        <p id="about-banner">
          <a href="/">Home</a> / <a href="/courses">Courses</a>
        </p>
      </div>
    </div>
  </div>
</div>
<!--BANNER AREA ENDS-->

<!--COURSES SECTION BEGINS-->
<div class="courses">
  <h4>Online Classes</h4>
  <p>
    Explore our course catalog, each designed and taught by industry experts,
    and embark on a journey of learning and growth. Join our community of tech
    enthusiasts, and let's embark on this exciting adventure together. Your tech
    future starts here Career Builders' Academy.
  </p>

  <div class="courses-collection">
    <% data.forEach(course => { %>
      <div id="course-item" class="<%= course.id %>">
        <a href="/course/<%= course.id %>">
          <img src="/img/cover/<%=course.image %>" alt="<%= course.title %>" loading="lazy" />
          <!-- <img src="/img/cover/1737329146460-23919842.JPG" alt="<%= course.title %>" loading="lazy" /> -->

          <script>
            console.log("/<%= course.image %>");
          </script>
          <div id="course-desc">
            <button>Online</button>
            <p><%= course.title %></p>
          </div>
        </a>
      </div>
    <% }) %>
  </div>
</div>
<!--COURSES SECTION ENDS-->

<!--COMING SOON SECTION BEGINS-->
