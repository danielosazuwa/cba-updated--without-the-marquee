      <img
        src="/img/courses/coming-soon.png"
        alt="Business Process Architect"
        loading="lazy"
      />
      <p>Business Process Architect</p>
    </div>

    <div id="coming-soon-div">
      <img
        src="/img/courses/coming-soon.png"
        alt="Cyber Security"
        loading="lazy"
      />
      <p>Cyber Security</p>
    </div>

    <div id="coming-soon-div">
      <img
        src="/img/courses/coming-soon.png"
        alt="Data Governance and Management"
        loading="lazy"
      />
      <p>Data Governance and Management</p>
    </div>

    <div id="coming-soon-div">
      <img
        src="/img/courses/coming-soon.png"
        alt="Project & Resource Planning"
        loading="lazy"
      />
      <p>Project & Resource Planning</p>
    </div>
  </div>
</div>
<!--COMING SOON SECTION ENDS-->

